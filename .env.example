# Database connection string (required)
DATABASE_URL=postgres://user:password@localhost:5432/cyberarena

# JWT signing secret – generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Allowed CORS origins, comma-separated (default: http://localhost:3000)
CORS_ORIGINS=http://localhost:3000

# Server port (default: 3000)
PORT=3000
